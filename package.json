{
  "name": "garoa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GAROA — a 16-bit RPG about arriving in São Paulo from the countryside",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run art:build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "art:build": "tsx tools/art/build.ts",
    "playtest": "tsx tools/playtest/run.ts",
    "playtest:life": "tsx tools/playtest/life-year.ts",
    "playtest:visual": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run playtest"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "pngjs": "^7.0.0",
    "@types/pngjs": "^6.0.5",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
